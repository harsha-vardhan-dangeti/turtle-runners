# ---------------------------------------------------------------------------
# Turtle Runners — environment
# Copy to .env.local:  cp .env.example .env.local
# ---------------------------------------------------------------------------

# Demo mode: run the whole app on seeded in-memory data, no database, no keys.
# Google sign-in is replaced by a "member / admin" picker.
# Set to false (or delete) once the Supabase values below are filled in.
NEXT_PUBLIC_DEMO=true

# Supabase project credentials.
# Supabase dashboard → Project Settings → API.
# The anon key is safe in the browser: Row Level Security is what protects data.
# Leave both blank and the app falls back to demo mode automatically.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of this deployment. Used to build the Google OAuth redirect.
# Local: http://localhost:3000 — Vercel sets this for you if you leave it blank.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Strava integration (optional — the app runs fine without it)
# ---------------------------------------------------------------------------

# Service role key. Supabase dashboard → Project Settings → API → service_role.
# This bypasses Row Level Security. Keep it server-side, never prefix it with
# NEXT_PUBLIC_, and never commit it. Only the Strava code uses it: OAuth tokens
# live in a table no browser is allowed to read.
SUPABASE_SERVICE_ROLE_KEY=

# Strava API application. Create one at https://www.strava.com/settings/api
# Set the callback domain there to this deployment's host (localhost for dev).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Encrypts members' Strava tokens before they are stored. Server-only; keep it
# out of Supabase and never commit it. Strava stays switched off without it.
# Generate one with:  openssl rand -base64 32
# Changing it later means every member reconnects Strava once.
STRAVA_TOKEN_KEY=

# Only needed when Strava's Authorization Callback Domain is NOT this site's
# current domain — Strava allows one, and rejects a redirect_uri outside it.
# Set it to the origin Strava still knows and the callback redirects onwards.
# Leave blank normally.
STRAVA_CALLBACK_ORIGIN=
